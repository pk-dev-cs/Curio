PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
# Clerk CLI uses VITE_CLERK_PUBLISHABLE_KEY; either public key name is supported.
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

TURSO_ORG=replace-me
TURSO_API_TOKEN=replace-me
TURSO_GROUP=curio
TURSO_GROUP_AUTH_TOKEN=replace-me

# Railway Bucket (S3-compatible object storage)
AWS_ENDPOINT_URL=https://storage.railway.app
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
AWS_S3_BUCKET_NAME=replace-me
AWS_DEFAULT_REGION=auto
